# Optional local AI. The app uses mock responses until explicitly enabled.
LM_STUDIO_ENABLED=false
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional if authentication is enabled in LM Studio. Never expose this as NEXT_PUBLIC.
LM_STUDIO_API_KEY=
# Nabz API is server-only; the browser uses same-origin /api/backend.
NABZ_API_URL=http://127.0.0.1:8081
# Docker compose.backend.yaml defaults to the sibling Nabz checkout and existing network.
# NABZ_BACKEND_PATH=../../nabz-crm/nabz-crm
# NABZ_DOCKER_NETWORK=nabz-ui_default
# Optional backend agent inference. Disabled until the local Qwen server is ready.
NABZ_AGENT_LM_STUDIO_ENABLED=false
NABZ_AGENT_LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
NABZ_AGENT_LM_STUDIO_API_KEY=
